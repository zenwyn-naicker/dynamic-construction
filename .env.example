# Copy values to your shell, user secrets or Azure settings. This file is documentation; it is not automatically loaded.
# Never put production secrets in VITE_* settings or frontend code.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
Database__Provider=SqlServer
ConnectionStrings__Database=Server=tcp:YOUR_SERVER.database.windows.net,1433;Database=YOUR_DATABASE;Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False
Storage__Provider=Azure
Storage__ContainerUri=https://YOUR_STORAGE.blob.core.windows.net/project-files
DataProtection__BlobUri=https://YOUR_STORAGE.blob.core.windows.net/data-protection/keys.xml
DataProtection__KeyIdentifier=https://YOUR_VAULT.vault.azure.net/keys/data-protection
APPLICATIONINSIGHTS_CONNECTION_STRING=SET_IN_AZURE
SCM_DO_BUILD_DURING_DEPLOYMENT=false
# Used only for the one-time CLI bootstrap, then remove both settings:
Bootstrap__Email=YOUR_ADMIN_EMAIL
Bootstrap__Password=SET_SECURELY_FOR_BOOTSTRAP_ONLY
